    "@vitest/browser-playwright": "^5.0.1",
    "eslint": "^9.0.0",
    "lit": "^3.1.0",
    "playwright": "^1.49.1",
    "prettier": "^3.3.0",
    "rollup": "^4.21.0",
    "tslib": "^2.8.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1"
